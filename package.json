{
  "name": "sheer",
  "private": true,
  "version": "2.0.0-rc.2",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "tools/lint"
  ],
  "overrides": {
    "ts-api-utils": {
      "typescript": "~6.0.3"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check": "bash scripts/check.sh",
    "check:fast": "bash scripts/check-fast.sh",
    "cargo": "bash scripts/cargo.sh",
    "target:budget": "node scripts/target-budget.mjs",
    "accept:clean": "node scripts/ui/accept/clean-recordings.mjs",
    "tools:install": "bash scripts/install-tools.sh",
    "bump-version": "bash scripts/bump-version.sh",
    "fetch-pdfium": "bash scripts/fetch-pdfium.sh",
    "fixtures:scans": "bash scripts/cargo.sh run --release --example make_scan_fixtures",
    "fixtures:owner-scans": "bash scripts/cargo.sh run --release --example make_scan_fixtures -- --owner",
    "build:acceptance": "node scripts/build-acceptance.mjs",
    "bench": "bash scripts/cargo.sh test --release --test perf_open -- --ignored --nocapture",
    "gen-installer-art": "node scripts/gen-installer-art.mjs",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.1",
    "lucide-react": "1.50.0",
    "motion": "14.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2",
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "2.12.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "axe-core": "4.11.0",
    "jsdom": "30.1.1",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
