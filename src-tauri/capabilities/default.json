{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: the app's own document, app and settings commands, plus the seven window-chrome permissions of the custom title bar (minimize, maximize, close, the two state reads, window dragging). No event, fs, shell, http or dialog permission and no default permission set: the backend reaches the webview through channels the webview passes to a command.",
  "windows": ["main"],
  "permissions": [
    "allow-open-document-dialog",
    "allow-open-welcome-document",
    "allow-unlock-document",
    "allow-list-recents",
    "allow-remove-recent",
    "allow-open-recent",
    "allow-restore-recent",
    "allow-locate-recent",
    "allow-set-menu-state",
    "allow-render-page",
    "allow-set-viewport",
    "allow-get-page-sizes",
    "allow-get-outline",
    "allow-get-text-layer",
    "allow-search",
    "allow-cancel-search",
    "allow-get-page-links",
    "allow-open-link",
    "allow-close-document",
    "allow-app-ready",
    "allow-get-settings",
    "allow-update-settings",
    "allow-watch-transparency",
    "allow-subscribe-menu",
    "allow-subscribe-app",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-is-maximized",
    "core:window:allow-is-fullscreen",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize"
  ]
}
