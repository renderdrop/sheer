    "allow-open-link",
    "allow-list-annotations",
    "allow-list-document-annotations",
    "allow-get-annotation-quote",
    "allow-create-citations",
    "allow-list-citations",
    "allow-get-bibliography",
    "allow-save-citation-list",
    "allow-list-signing-identities",
